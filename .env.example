# ==============================================================================
# MÂY / DEKA Ecosystem Environment Configuration Template
# COPY THIS TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT .env TO GIT!
# ==============================================================================

# 1. General & Runtime Environment
NODE_ENV=development # options: development, staging, production
PORT=8080

# 2. Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-b

# 3. Google Cloud Storage (Bucket Name)
# In production, generated as deka-media-${GCP_PROJECT_ID}
GCS_BUCKET=deka-media-your-gcp-project-id

# 4. Managed Database (PostgreSQL)
# Production: Injected via Google Secret Manager secret "DATABASE_URL"
# Local Docker Compose:
DATABASE_URL=postgresql://deka_dev:deka_dev_password@localhost:5432/deka_development

# 5. Redis Queue (DEKA Server / Workers)
# Production: Injected via Google Secret Manager secret "REDIS_PASSWORD"
# Local Docker Compose:
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# 6. Service-to-Service Security & Internal APIs
# Authenticates Cloud Run requests dispatching jobs to DEKA Server
# Production: Injected via Google Secret Manager secret "INTERNAL_API_KEY"
INTERNAL_API_KEY=dev-internal-secret-key
DEKA_SERVER_URL=http://localhost:4000

# 7. AI Providers
# Production: Injected via Google Secret Manager secret "GEMINI_API_KEY"
GEMINI_API_KEY=your-gemini-api-key-here

# 8. MÂY Brand Configuration (Optional Overrides)
BRAND_NAME="MÂY"
BRAND_TAGLINE="YOUR BEAUTY, OUR PROMISE"
BRAND_PHONE="0931 73 75 79"
NEXT_PUBLIC_API_URL=http://localhost:8080
